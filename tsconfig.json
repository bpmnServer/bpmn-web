{
  "compilerOptions": {
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "target": "ES2022", "lib": ["ES2022","DOM"],
    "sourceMap": true, "declaration": false, "allowJs": true,
    "esModuleInterop": true, "skipLibCheck": true, "strict": false,
    "rootDir": "./src", "outDir": "./dist", "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules","dist","src/examples","src/test","src/scripts","src/tmp",
              "src/WorkflowApp/appServices.ts","src/WorkflowApp/INSTALL_appDelegate.ts","src/WorkflowApp/INSTALL_configuration.ts"]
}
