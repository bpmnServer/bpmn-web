{
  "name": "bpmn-web",
  "version": "3.0.1",
  "description": "bpmn-web Demo App",
  "type": "module",
  "author": {
    "name": "bpmnServer RalphHanna"
  },
  "scripts": {
    "build": "tsc --build",
    "start": "node --import tsx src/app.ts",
    "start:prod": "node dist/app.js",
    "clean": "tsc --build --clean",
    "test": "node --import tsx src/test/setup.ts && node --import tsx ./node_modules/mocha/bin/mocha.js --config=src/test/.mocharc.json src/test/feature",
    "test:engine": "node --test web-engine.test.mjs",
    "test:unit": "node --test apikey-auth.test.mjs && node --test api-versioning.test.mjs && node --test admin-route-boundary.test.mjs"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.3.0",
    "bpmn-server": "^3.0.1",
    "compression": "^1.8.1",
    "connect-busboy": "^1.0.0",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "errorhandler": "^1.5.2",
    "express": "^5.2.1",
    "express-flash": "^0.0.2",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lodash": "^4.18.1",
    "lusca": "^1.7.0",
    "mailchecker": "^6.0.21",
    "mongoose": "^9.8.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pug": "^3.0.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/lodash": "^4.17.24",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/validator": "^13.15.10",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "mocha-cakes-2": "^3.3.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
