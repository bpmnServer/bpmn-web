<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="TrackClaimDefinitions" targetNamespace="urn:insurance:claims">
  <bpmn:process id="TrackClaim" name="Track a claim" isExecutable="true">
    <bpmn:startEvent id="ClaimTrackingOpened" name="Claim Tracking Opened">
      <bpmn:outgoing>ClaimTrackingOpenedToFollowUpTheClaim</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="FollowUpTheClaim" name="Follow up the claim" camunda:candidateGroups="claimsAgent">
      <bpmn:incoming>ClaimTrackingOpenedToFollowUpTheClaim</bpmn:incoming>
      <bpmn:incoming>OutcomeToFollowUpTheClaim</bpmn:incoming>
      <bpmn:outgoing>FollowUpTheClaimToOutcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Outcome" name="Tracking outcome" default="OutcomeToTrackingClosed">
      <bpmn:incoming>FollowUpTheClaimToOutcome</bpmn:incoming>
      <bpmn:outgoing>OutcomeToFollowUpTheClaim</bpmn:outgoing>
      <bpmn:outgoing>OutcomeToTrackingClosed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="TrackingClosed" name="Tracking closed">
      <bpmn:incoming>OutcomeToTrackingClosed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ClaimTrackingOpenedToFollowUpTheClaim" sourceRef="ClaimTrackingOpened" targetRef="FollowUpTheClaim" />
    <bpmn:sequenceFlow id="FollowUpTheClaimToOutcome" sourceRef="FollowUpTheClaim" targetRef="Outcome" />
    <bpmn:sequenceFlow id="OutcomeToFollowUpTheClaim" sourceRef="Outcome" targetRef="FollowUpTheClaim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$(data.status === 'Open')</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="OutcomeToTrackingClosed" sourceRef="Outcome" targetRef="TrackingClosed" />
  </bpmn:process>
</bpmn:definitions>
